{
  "name": "physioflo-testing",
  "version": "1.0.0",
  "description": "Testing suite for PhysioFlow application",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:single-user": "playwright test e2e/single-user-flow.spec.ts",
    "test:multi-user": "playwright test e2e/multi-user-isolation.spec.ts",
    "test:mobile": "playwright test --project='Mobile Chrome'",
    "test:all": "playwright test --reporter=html",
    "install-browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
